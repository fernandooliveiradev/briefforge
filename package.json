{
  "name": "briefforge",
  "version": "0.1.0",
  "description": "AI-powered fictional client brief generator for designers, developers, and portfolio projects.",
  "private": false,
  "license": "Apache-2.0",
  "keywords": [
    "briefing",
    "portfolio",
    "branding",
    "deepseek",
    "openai",
    "sqlite",
    "nextjs"
  ],
  "author": {
    "name": "Fernando de Oliveira",
    "url": "https://fernandodeoliveira.pro"
  },
  "homepage": "https://fernandodeoliveira.pro",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "glob": "10.5.0",
      "minimatch": "9.0.7",
      "picomatch": "2.3.2",
      "postcss": "8.5.10",
      "yaml": "2.8.3"
    }
  },
  "scripts": {
    "predev": "node scripts/check-runtime.mjs",
    "dev": "node scripts/next-runner.mjs dev",
    "prebuild": "node scripts/check-runtime.mjs",
    "build": "node scripts/next-runner.mjs build",
    "prestart": "node scripts/check-runtime.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.18",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
